<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Frieren, Beyond Journey’s End</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500&display=swap">
<style>
:root{--bg:#ffffff;--bg2:#ffffff;--bg3:#f6f7fb;--text:#2c3545;--muted:#66728a;--blue:#8faadc;--blue2:#b4c6e7;--gold:#c5a880;--red:#a83232;--card:rgba(255,255,255,.78);--line:#e6eaf3;--nav:rgba(255,255,255,.72);--petal:#b4c6e7;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root{color-scheme:light}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:5rem;height:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;line-height:1.75;overflow-x:hidden}
canvas#petals{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}
h1,h2,h3,.serif{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500}
nav{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:calc(.9rem + env(safe-area-inset-top,0px)) 5vw .9rem;transition:.3s}
nav.solid{background:var(--nav);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.brand{font-family:"Cormorant Garamond",serif;letter-spacing:.3em;font-size:1.05rem;text-transform:uppercase;color:var(--text);text-decoration:none}
nav ul{display:flex;gap:1.6rem;list-style:none;margin:0;padding:0;overflow-x:auto}
nav a.l{color:var(--muted);text-decoration:none;font-size:.82rem;white-space:nowrap;padding-bottom:.2rem;border-bottom:2px solid transparent;transition:.2s}
nav a.l:hover{color:var(--text);border-color:var(--red)}
@media(max-width:720px){nav{flex-direction:column;gap:.4rem}nav ul{gap:1rem;max-width:100%}}
main,footer,header{position:relative;z-index:2}
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:8rem 1.5rem 4rem;background:linear-gradient(180deg,var(--bg) 0%,var(--bg3) 100%)}
.hero h1{font-size:clamp(3rem,10vw,6.5rem);letter-spacing:.35em;margin:0;padding-left:.35em;text-transform:uppercase}
.hero .sub{font-family:"Cormorant Garamond",serif;font-size:clamp(1.2rem,3vw,1.8rem);border-top:1px solid var(--gold);display:inline-block;padding-top:.6rem;margin-top:.8rem;color:var(--muted)}
.hero blockquote{max-width:32rem;margin:2.2rem auto 0;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:1.3rem;color:var(--muted)}
.btn{display:inline-block;margin-top:2rem;padding:.8rem 2rem;background:var(--blue);color:#fff;text-decoration:none;border-radius:4px;font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;transition:.25s}
.btn:hover{filter:brightness(1.12);transform:translateY(-2px)}
.frame{width:min(34rem,90vw);aspect-ratio:498/282;margin-top:3rem;border:1px solid var(--blue2);border-radius:14px;overflow:hidden;box-shadow:0 0 60px rgba(143,170,220,.35);background:#fff}
.frame video{width:100%;height:100%;display:block;object-fit:cover}
section{padding:6rem 1.5rem}
.wrap{max-width:64rem;margin:0 auto}
.alt{background:var(--bg2)}
.kicker{font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);display:block;margin-bottom:.6rem}
h2{font-size:clamp(2rem,5vw,3rem);margin:0 0 1rem;text-transform:uppercase;letter-spacing:.06em}
.center{text-align:center}
.lede{max-width:40rem;color:var(--muted);margin:0 auto}
.time{display:flex;flex-wrap:wrap;gap:3rem;justify-content:center;margin-top:3rem}
.time div{text-align:center}
.time b{display:block;font-family:"Cormorant Garamond",serif;font-weight:500;font-size:clamp(4rem,12vw,7rem);line-height:1;color:var(--blue)}
.time span{font-size:.8rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}
.tabs{display:flex;justify-content:center;gap:.6rem;margin:2rem 0;flex-wrap:wrap}
.tab{font:inherit;font-size:.85rem;padding:.6rem 1.4rem;border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:999px;cursor:pointer;transition:.2s}
.tab[aria-selected="true"]{background:var(--blue);border-color:var(--blue);color:#fff}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1.3rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:1.6rem;box-shadow:0 8px 30px rgba(44,53,69,.06);transition:.3s;backdrop-filter:blur(6px)}
.card:hover{border-color:var(--gold);transform:translateY(-5px);box-shadow:0 14px 36px rgba(197,168,128,.25)}
.card .cls{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.card h3{font-size:1.7rem;margin:.2rem 0 .1rem}
.card .role{font-size:.82rem;color:var(--blue);margin-bottom:.7rem}
.card p{font-size:.92rem;color:var(--muted);margin:0 0 .8rem}
.card .trait{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:1.05rem;border-top:1px solid var(--line);padding-top:.7rem}
[hidden]{display:none!important}
.tl{position:relative;max-width:42rem;margin:3rem auto 0;padding-left:2.6rem}
.tl::before{content:"";position:absolute;left:.7rem;top:0;bottom:0;width:1px;background:linear-gradient(var(--blue2),var(--blue))}
.node{position:relative;margin-bottom:2.8rem}
.node::before{content:"✦";position:absolute;left:-2.55rem;top:-.1rem;width:1.5rem;text-align:center;color:var(--blue);background:var(--bg);font-size:1rem}
.node small{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}
.node h3{font-size:1.6rem;margin:.1rem 0 .3rem}
.node p{margin:0;color:var(--muted);font-size:.95rem}
.spells{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.2rem;margin-top:2.5rem}
.spell{font:inherit;text-align:left;cursor:pointer;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:1.4rem;color:var(--text);transition:.3s;position:relative;overflow:hidden;min-height:11rem}
.spell:hover{border-color:var(--blue)}
.spell h3{font-size:1.35rem;margin:0 0 .4rem}
.spell .hint{font-size:.78rem;color:var(--muted)}
.spell .story{display:none;font-size:.9rem;color:var(--muted);margin-top:.6rem}
.spell.open .story{display:block}
.spell.open .hint{display:none}
.spell i{position:absolute;width:10px;height:14px;border-radius:70% 30% 70% 30%;background:var(--blue2);opacity:0;pointer-events:none}
.spell.open i{animation:rise 1.8s ease-out forwards}
@keyframes rise{0%{opacity:.9;transform:translate(0,0) rotate(0)}100%{opacity:0;transform:translate(var(--x),-8rem) rotate(200deg)}}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.reveal.in{opacity:1;transform:none}
footer{text-align:center;padding:5rem 1.5rem 4rem;background:linear-gradient(var(--bg),var(--bg3))}
footer svg{width:72px;height:72px}
footer p{max-width:30rem;margin:1rem auto;color:var(--muted);font-family:"Cormorant Garamond",serif;font-size:1.3rem;font-style:italic}
footer small{color:var(--muted);font-size:.72rem}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
</style>
</head>
<body>
<canvas id="petals" aria-hidden="true"></canvas>
<nav id="nav">
  <a class="brand" href="#topo">Frieren</a>
  <ul>
    <li><a class="l" href="#tempo">A Jornada</a></li>
    <li><a class="l" href="#grupo">O Grupo</a></li>
    <li><a class="l" href="#linha">Linha do Tempo</a></li>
    <li><a class="l" href="#grimorio">Grimório de Memórias</a></li>
  </ul>
</nav>

<header class="hero" id="topo">
  <h1>Frieren</h1>
  <div class="sub">Beyond Journey’s End</div>
  <blockquote>“Para quem vive mil anos, dez anos cabem num suspiro. Só depois se descobre o quanto pesavam.”</blockquote>
  <a class="btn" href="#tempo">Começar a leitura</a>
  <div class="frame"><video autoplay loop muted playsinline preload="auto" aria-label="Frieren e Himmel" src="data:video/mp4;base64,"></video></div>
</header>

<main>
<section id="tempo">
  <div class="wrap center reveal">
    <span class="kicker">A passagem do tempo</span>
    <h2>Dez anos, uma vida</h2>
    <p class="lede">Frieren é uma elfa de mais de mil anos. A viagem com o grupo do herói durou dez anos, quase nada para ela e quase tudo para os companheiros humanos. Quando Himmel morre, cinquenta anos depois, ela percebe que passou tempo ao lado dele sem tentar conhecê-lo.</p>
    <div class="time">
      <div><b data-n="10">0</b><span>anos de viagem</span></div>
      <div><b data-n="50">0</b><span>anos até a despedida de Himmel</span></div>
      <div><b data-n="1000">0</b><span>anos de vida da elfa, ou mais</span></div>
    </div>
  </div>
</section>

<section id="grupo" class="alt">
  <div class="wrap">
    <div class="center reveal"><span class="kicker">Os companheiros</span><h2>O Grupo</h2></div>
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" aria-selected="true" data-t="past">O Grupo Lendário (Passado)</button>
      <button class="tab" role="tab" aria-selected="false" data-t="now">A Nova Jornada (Presente)</button>
    </div>
    <div class="grid" id="past">
      <article class="card"><div class="cls">Espadachim</div><h3>Himmel</h3><div class="role">O herói</div><p>Humano de coração generoso, atendia pedidos de ajuda por menores que fossem e adorava deixar estátuas de si mesmo pelo caminho. Foi quem mais se importou em ser lembrado, e foi lembrado.</p><div class="trait">Traço: vaidade que escondia bondade.</div></article>
      <article class="card"><div class="cls">Sacerdote</div><h3>Heiter</h3><div class="role">O padre</div><p>Clérigo humano que bebe e joga mais do que o hábito sugere. Por baixo da galhofa, entende as pessoas e cuida do grupo. Mais tarde cria a órfã Fern.</p><div class="trait">Traço: leveza que cobre responsabilidade.</div></article>
      <article class="card"><div class="cls">Guerreiro</div><h3>Eisen</h3><div class="role">O anão</div><p>De poucas palavras e muita firmeza, aguenta qualquer golpe na linha de frente. Vive mais que os amigos humanos e vê o grupo envelhecer.</p><div class="trait">Traço: firmeza e lealdade silenciosa.</div></article>
      <article class="card"><div class="cls">Maga</div><h3>Frieren</h3><div class="role">A elfa</div><p>Poderosa, dorminhoca e distraída com o tempo. Coleciona feitiços sem importância. Depois da morte de Himmel, parte para conhecer melhor o que viveu.</p><div class="trait">Traço: tempo longo demais para notar o agora.</div></article>
    </div>
    <div class="grid" id="now" hidden>
      <article class="card"><div class="cls">Maga</div><h3>Frieren</h3><div class="role">Mentora do grupo</div><p>Segue para o norte, rumo a Ende, onde dizem que as almas dos mortos podem ser ouvidas. Cada lugar da estrada guarda uma lembrança dos velhos companheiros.</p><div class="trait">Traço: aprende a olhar para o presente.</div></article>
      <article class="card"><div class="cls">Maga</div><h3>Fern</h3><div class="role">A aprendiz</div><p>Humana criada por Heiter e treinada por Frieren. Disciplinada e prática, é quem põe a elfa nos trilhos quando ela se distrai.</p><div class="trait">Traço: disciplina e pés no chão.</div></article>
      <article class="card"><div class="cls">Guerreiro</div><h3>Stark</h3><div class="role">O discípulo de Eisen</div><p>Humano assustadiço que carrega a coragem do mestre sem acreditar nela. Quando o grupo precisa, ele aparece.</p><div class="trait">Traço: medo que não o impede de agir.</div></article>
    </div>
  </div>
</section>

<section id="linha">
  <div class="wrap">
    <div class="center reveal"><span class="kicker">Marcos</span><h2>Linha do Tempo</h2></div>
    <div class="tl">
      <div class="node reveal"><small>Dez anos de estrada</small><h3>A derrota do Rei Demônio</h3><p>Himmel, Heiter, Eisen e Frieren vencem o Rei Demônio e voltam como lendas.</p></div>
      <div class="node reveal"><small>Cinquenta anos depois</small><h3>A Chuva de Meteoros Era</h3><p>Os quatro se reencontram para ver o espetáculo que Himmel prometeu. Para Frieren, meio século passou como um piscar.</p></div>
      <div class="node reveal"><small>O luto</small><h3>A despedida de Himmel</h3><p>Himmel morre de velhice. Frieren chora e decide conhecer melhor aquilo que deixou passar.</p></div>
      <div class="node reveal"><small>A nova viagem</small><h3>O encontro com Fern e Stark</h3><p>Fern, criada por Heiter, e Stark, aprendiz de Eisen, entram no caminho de Frieren.</p></div>
      <div class="node reveal"><small>Rumo ao norte</small><h3>A viagem para Ende</h3><p>O novo grupo segue até onde as almas descansam, seguindo os passos do antigo.</p></div>
    </div>
  </div>
</section>

<section id="grimorio" class="alt">
  <div class="wrap">
    <div class="center reveal"><span class="kicker">Easter egg</span><h2>Grimório de Memórias</h2><p class="lede">Frieren coleciona feitiços que ninguém consideraria úteis. Clique para ver cada um.</p></div>
    <div class="spells">
      <button class="spell"><h3>Campo de flores</h3><div class="hint">Toque para abrir</div><div class="story">Um feitiço que só faz nascer flores. Frieren o aprendeu com sua mestra, Flamme, e o usa sem pressa, porque aquelas flores também são lembrança.</div></button>
      <button class="spell"><h3>Limpar manchas de roupa</h3><div class="hint">Toque para abrir</div><div class="story">Um truque doméstico que Frieren guarda no grimório. Cabe aqui a história de quem o ensinou a ela.</div></button>
      <button class="spell"><h3>Feitiço de uvas</h3><div class="hint">Toque para abrir</div><div class="story">Mais um feitiço sem utilidade aparente. Aqui também entra a história de quem o ensinou.</div></button>
    </div>
  </div>
</section>
</main>

<footer>
  <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M32 60V34" stroke="#8fb59b" stroke-width="2"/><g fill="#b4c6e7" stroke="#8faadc"><path d="M32 30C20 28 12 18 14 8c10 0 18 8 18 22z"/><path d="M32 30C44 28 52 18 50 8c-10 0-18 8-18 22z"/><path d="M32 32C20 36 10 32 6 24c8-6 20-2 26 8z"/><path d="M32 32c12 4 22 0 26-8-8-6-20-2-26 8z"/></g><circle cx="32" cy="30" r="3" fill="#c5a880"/></svg>
  <p>“As flores ficam depois que a viagem acaba.”</p>
  <small>Página de fã. Sousou no Frieren pertence a Kanehito Yamada, Tsukasa Abe e aos seus detentores.<br>Feito por <a href="https://github.com/izumilg" target="_blank" rel="noopener" style="color:var(--blue)">izumilg</a></small>
</footer>

<script>
(function(){
var nav=document.getElementById('nav');
addEventListener('scroll',function(){nav.classList.toggle('solid',scrollY>40)},{passive:true});

var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15});
document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});

var co=new IntersectionObserver(function(es){es.forEach(function(e){if(!e.isIntersecting)return;
document.querySelectorAll('[data-n]').forEach(function(b){var n=+b.dataset.n,t0=null;(function s(t){t0=t0||t;var p=Math.min((t-t0)/1400,1);b.textContent=Math.round(n*p).toLocaleString('pt-BR');if(p<1)requestAnimationFrame(s)})(performance.now())});
co.disconnect()})},{threshold:.4});
co.observe(document.querySelector('.time'));

document.querySelectorAll('.tab').forEach(function(t){t.addEventListener('click',function(){
document.querySelectorAll('.tab').forEach(function(x){x.setAttribute('aria-selected',x===t)});
document.getElementById('past').hidden=t.dataset.t!=='past';
document.getElementById('now').hidden=t.dataset.t!=='now'})});

document.querySelectorAll('.spell').forEach(function(s){s.addEventListener('click',function(){
s.classList.toggle('open');
if(s.classList.contains('open')){for(var i=0;i<12;i++){var p=document.createElement('i');p.style.left=(10+Math.random()*80)+'%';p.style.bottom='10px';p.style.setProperty('--x',(Math.random()*60-30)+'px');p.style.animationDelay=(Math.random()*.5)+'s';s.appendChild(p);setTimeout(function(q){q.remove()},2600,p)}}})});

var cv=document.getElementById('petals'),cx=cv.getContext('2d'),W,H,P=[];
function size(){W=cv.width=innerWidth;H=cv.height=innerHeight}size();addEventListener('resize',size);
if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
var col=function(){return getComputedStyle(document.documentElement).getPropertyValue('--petal').trim()||'#b4c6e7'};
for(var i=0;i<22;i++)P.push({x:Math.random()*W,y:Math.random()*H,s:6+Math.random()*12,v:.25+Math.random()*.6,d:Math.random()*6.28,r:Math.random()*6.28,z:.2+Math.random()*.8});
var lastY=scrollY;
(function loop(){cx.clearRect(0,0,W,H);cx.fillStyle=col();
var dy=scrollY-lastY;lastY=scrollY;
P.forEach(function(p){p.d+=.01;p.r+=.008;p.y+=p.v-dy*p.z*.4;p.x+=Math.sin(p.d)*.5;
if(p.y>H+20){p.y=-20;p.x=Math.random()*W}if(p.y<-30)p.y=H+10;
cx.save();cx.globalAlpha=.25+p.z*.3;cx.translate(p.x,p.y);cx.rotate(p.r);cx.beginPath();cx.ellipse(0,0,p.s*.45,p.s,0,0,6.28);cx.fill();cx.restore()});
requestAnimationFrame(loop)})();
})();
</script>
</body>
</html>
